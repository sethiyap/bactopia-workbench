#!/usr/bin/env bash

# Copy to config/sites/local.local.env.
# For running on a single Linux host with NO job scheduler (no Slurm/PBS).
# Every stage runs locally, and Bactopia's own processes run with Nextflow's
# local executor (see NEXTFLOW_CONFIG below). Edit the paths for your machine.

PROJECT=${PROJECT:-local}
USER_NAME=${USER_NAME:-$USER}

PIPELINE_ROOT=${PIPELINE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}

RUN_AGAR_DIR=${RUN_AGAR_DIR:-$PIPELINE_ROOT}
BACTOPIA_PIPELINE=${BACTOPIA_PIPELINE:-/path/to/bactopia}
DATASETS_CACHE=${DATASETS_CACHE:-/path/to/bactopia_datasets_custom}
KRAKEN2_DB=${KRAKEN2_DB:-/path/to/kraken2_db}

# Local Nextflow config: process.executor = 'local' (no sbatch/qsub).
NEXTFLOW_CONFIG=${NEXTFLOW_CONFIG:-$PIPELINE_ROOT/scripts/nextflow.local.all_tools.config}
KLEBORATE_COMPAT_SCRIPT=${KLEBORATE_COMPAT_SCRIPT:-$PIPELINE_ROOT/scripts/kleborate_232_compat.sh}
MINIFORGE_ROOT=${MINIFORGE_ROOT:-$PIPELINE_ROOT/.local/miniforge3}
MLST_ENV=${MLST_ENV:-$PIPELINE_ROOT/.local/mlst_env}

# Tools come from PATH / an active conda env, not environment modules.
USE_MODULES=${USE_MODULES:-0}

# FimTyper is opt-in on every backend (same default as defaults.env). To enable,
# set RUN_FIMTYPER=1 and make sure the FimTyper container (FIMTYPER_CONTAINER, a
# local .sif) is available. FIMTYPER_CONFIG below already points at the
# local-executor config so a local run does not try to submit to a scheduler.
RUN_FIMTYPER=${RUN_FIMTYPER:-0}
FIMTYPER_PIPELINE=${FIMTYPER_PIPELINE:-$PIPELINE_ROOT/bactopia_config/fimtyper.nf}
FIMTYPER_CONFIG=${FIMTYPER_CONFIG:-$PIPELINE_ROOT/bactopia_config/fimtyper.local.config}
MERGE_FIMTYPER_SCRIPT=${MERGE_FIMTYPER_SCRIPT:-$PIPELINE_ROOT/scripts/merge_fimtyper_summary.sh}

# ST131Typer works on the local backend as-is (it is a plain bash script, not a
# Nextflow/scheduler stage). To enable, set RUN_ST131_TYPER=1 and point at your
# clone; mlst + seqkit must be on PATH (e.g. from the active conda env / MLST_ENV).
# RUN_ST131_TYPER=1
# ST131_TYPER_DIR=/absolute/path/to/ST131Typer
# RUN_COLLECT_ASSEMBLIES stays 1 (default) so the assemblies folder is produced.

RESULTS_ROOT_DEFAULT=${RESULTS_ROOT_DEFAULT:-$HOME/bactopia_runs}
SING_CACHE=${SING_CACHE:-$HOME/singularity_cache}
BASE_DIR=${BASE_DIR:-${PIPELINE_ROOT}}
CHECK_INODE_QUOTA=${CHECK_INODE_QUOTA:-0}

# Optional: skip samples whose name matches this regex (case-insensitive) so they are
# never batched or assembled -- handy for ONT controls like the unclassified barcode
# bin, Lambda spike-ins, or negative controls. Excluded samples are logged. Example:
# EXCLUDE_SAMPLE_REGEX='unclassified|lambda|neg'
EXCLUDE_SAMPLE_REGEX=${EXCLUDE_SAMPLE_REGEX:-}

# Optional local resource caps consumed by nextflow.local.all_tools.config.
# IMPORTANT: most processes request 4 cpus each, and the local executor admits
# tasks against LOCAL_MAX_CPUS (and LOCAL_MAX_MEMORY). So effective concurrency is
# min(LOCAL_MAX_FORKS, LOCAL_MAX_CPUS / 4, LOCAL_MAX_MEMORY / per_task_mem). These
# defaults are laptop-safe but run ONE task at a time (4 cpus / 4 = 1), which can
# make a run take many hours on a big host. Scale LOCAL_MAX_CPUS and LOCAL_MAX_MEMORY
# up with LOCAL_MAX_FORKS or concurrency silently collapses to one -- e.g. on a
# 64-core / 256 GB host: LOCAL_MAX_CPUS=64, LOCAL_MAX_MEMORY=256.GB, LOCAL_MAX_FORKS=16.
LOCAL_MAX_CPUS=${LOCAL_MAX_CPUS:-4}
LOCAL_MAX_MEMORY=${LOCAL_MAX_MEMORY:-16.GB}
LOCAL_MAX_FORKS=${LOCAL_MAX_FORKS:-2}
