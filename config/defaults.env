#!/usr/bin/env bash

# Core pipeline defaults. These are scheduler-agnostic and intended to be shared
# across sites.

BATCH_SIZE_DEFAULT=${BATCH_SIZE_DEFAULT:-50}
BATCH_PREFIX=${BATCH_PREFIX:-batch_bactopia}

# Expected genome size (bp) passed to Bactopia as --genome_size. It drives BOTH the
# coverage QC gate (min basepairs = 10 x GENOME_SIZE) AND rasusa read subsampling
# (coverage x GENOME_SIZE), so it must be a realistic size -- 0/1 shrink reads to ~0
# bp and fail QC rather than disabling it. Leave empty to fall back to 5 Mb. Override
# per run with --genome-size N. To relax the QC gates, use EXTRA_ARGS_STRING below.
GENOME_SIZE=${GENOME_SIZE:-}

# Extra arguments appended verbatim to the Bactopia command line (space-separated,
# word-split). Use to relax Bactopia's QC gates, e.g.
# EXTRA_ARGS_STRING="--coverage 0 --min_coverage 0 --min_basepairs 0 --min_reads 0".
# --min_coverage 0 disables the "N x coverage" gate (genome_size x 10, the usual
# reason shallow samples are discontinued); --coverage 0 skips rasusa subsampling;
# --min_basepairs 0 / --min_reads 0 disable the absolute read/basepair floors.
# Forwarded to the batch job on every backend (PBS/Slurm/local).
EXTRA_ARGS_STRING=${EXTRA_ARGS_STRING:-}

RUN_TOOLS=${RUN_TOOLS:-1}
RUN_TOOLS_PARALLEL=${RUN_TOOLS_PARALLEL:-0}
RUN_ADDITIONAL_TOOLS=${RUN_ADDITIONAL_TOOLS:-0}
RUN_KLEBORATE=${RUN_KLEBORATE:-1}
# FimTyper defaults ON. The container now has a universal default (the published
# GHCR image, pulled via docker:// by fimtyper.local/slurm.config), so no per-host
# setup is required on a networked host. Set RUN_FIMTYPER=0 to disable. If a local
# FIMTYPER_CONTAINER .sif path is given but missing, the batch job skips FimTyper
# with a warning instead of failing.
RUN_FIMTYPER=${RUN_FIMTYPER:-1}
FIMTYPER_AFTER=${FIMTYPER_AFTER:-all_tools}
RUN_COLLECT_ASSEMBLIES=${RUN_COLLECT_ASSEMBLIES:-1}
# ST131Typer defaults ON, but is E. coli ST131-specific and needs a local clone.
# If the clone is absent, the run logs a warning and skips it (never fails). Set
# RUN_ST131_TYPER=0 to disable, or install it with install_optional_local_tools.sh.
RUN_ST131_TYPER=${RUN_ST131_TYPER:-1}
# PADLOC (antiviral / anti-phage defence systems) is NOT a Bactopia v3.2.0
# bactopia-tool, so it cannot go in TOOLS_STRING -- it runs as a standalone stage
# per batch. OFF by default because it needs both a padloc install and a ~1 GB
# PADLOC-DB that this repo does not provision. Turn it on with RUN_PADLOC=1 (or
# --padloc) once one of PADLOC_ENV / PADLOC_BIN / PADLOC_CONTAINER is set; if none
# resolves, the run warns and skips PADLOC rather than failing.
#   PADLOC_ENV       conda env prefix, e.g. /opt/conda/envs/padloc_2.0.0
#   PADLOC_BIN       explicit path to the padloc executable
#   PADLOC_CONTAINER Singularity/Apptainer image (requires PADLOC_DB)
#   PADLOC_DB        PADLOC-DB dir; leave empty to use the install's own data dir
#                    (correct for a conda env that has had `padloc --db-update` run)
RUN_PADLOC=${RUN_PADLOC:-0}
PADLOC_ENV=${PADLOC_ENV:-}
PADLOC_BIN=${PADLOC_BIN:-}
PADLOC_CONTAINER=${PADLOC_CONTAINER:-}
PADLOC_DB=${PADLOC_DB:-}
PADLOC_CPUS=${PADLOC_CPUS:-8}
# Keep PADLOC's HMMER domain tables and Prodigal predictions (large) alongside the
# *_padloc.csv/.gff results.
PADLOC_KEEP_INTERMEDIATES=${PADLOC_KEEP_INTERMEDIATES:-0}
MAP_AGRF_RESULTS=${MAP_AGRF_RESULTS:-1}
RUN_MLST_REVIEW=${RUN_MLST_REVIEW:-1}
RUN_EXPORT_RESULTS_WORKBOOK=${RUN_EXPORT_RESULTS_WORKBOOK:-1}

BATCH_SKIP=${BATCH_SKIP:-0}
BATCH_START=${BATCH_START:-}
BATCH_IDS=${BATCH_IDS:-}
BATCH_LIMIT=${BATCH_LIMIT:-}
BATCH_CHAIN=${BATCH_CHAIN:-1}

DEFAULT_TOOLS_STRING=${DEFAULT_TOOLS_STRING:-abritamr amrfinderplus bracken checkm mlst plasmidfinder}
# defensefinder is deliberately NOT in this bundle. It queries GitHub for its model
# version on every run (DEFENSEFINDER_UPDATE, no flag skips it in the pinned
# release), so on a cluster whose compute nodes have no outbound internet -- Gadi --
# it cannot produce results under any configuration, and a missing container image
# aborts the stage at pull time before any errorStrategy can catch it, deleting every
# afterok-dependent stage behind it. Add it back to ADDITIONAL_TOOLS_STRING (or to
# TOOLS_STRING) on a site whose compute nodes do reach the internet, e.g. firefly.
# See CLAUDE.md, "A failed pull poisons SING_CACHE".
ADDITIONAL_TOOLS_STRING=${ADDITIONAL_TOOLS_STRING:-ectyper ismapper mashdist mobsuite mykrobe phispy shigapass shigatyper shigeifinder}
