#!/usr/bin/env bash

# Core pipeline defaults. These are scheduler-agnostic and intended to be shared
# across sites.

BATCH_SIZE_DEFAULT=${BATCH_SIZE_DEFAULT:-50}
BATCH_PREFIX=${BATCH_PREFIX:-batch_bactopia}

# Expected genome size (bp) passed to Bactopia as --genome_size. It drives BOTH the
# coverage QC gate (min basepairs = 10 x GENOME_SIZE) AND rasusa read subsampling
# (coverage x GENOME_SIZE), so it must be a realistic size -- 0/1 shrink reads to ~0
# bp and fail QC rather than disabling it. Leave empty to fall back to 5 Mb. Override
# per run with --genome-size N. To relax the QC gates, use EXTRA_ARGS_STRING below.
GENOME_SIZE=${GENOME_SIZE:-}

# Extra arguments appended verbatim to the Bactopia command line (space-separated,
# word-split). Use to relax the QC gates that genome size does NOT control, e.g.
# EXTRA_ARGS_STRING="--coverage 0 --min_basepairs 0 --min_reads 0" -- "--coverage 0"
# is what actually skips rasusa subsampling. Forwarded to the batch job on every
# backend (PBS/Slurm/local).
EXTRA_ARGS_STRING=${EXTRA_ARGS_STRING:-}

RUN_TOOLS=${RUN_TOOLS:-1}
RUN_TOOLS_PARALLEL=${RUN_TOOLS_PARALLEL:-0}
RUN_ADDITIONAL_TOOLS=${RUN_ADDITIONAL_TOOLS:-0}
RUN_KLEBORATE=${RUN_KLEBORATE:-1}
# FimTyper is opt-in on every backend: it needs its own Nextflow config plus a
# FimTyper container that has no universal default. Enable per run (or in a site
# config) with RUN_FIMTYPER=1 + FIMTYPER_PIPELINE/FIMTYPER_CONFIG/FIMTYPER_CONTAINER.
RUN_FIMTYPER=${RUN_FIMTYPER:-0}
FIMTYPER_AFTER=${FIMTYPER_AFTER:-all_tools}
RUN_COLLECT_ASSEMBLIES=${RUN_COLLECT_ASSEMBLIES:-1}
MAP_AGRF_RESULTS=${MAP_AGRF_RESULTS:-1}
RUN_MLST_REVIEW=${RUN_MLST_REVIEW:-1}
RUN_EXPORT_RESULTS_WORKBOOK=${RUN_EXPORT_RESULTS_WORKBOOK:-1}

BATCH_SKIP=${BATCH_SKIP:-0}
BATCH_START=${BATCH_START:-}
BATCH_IDS=${BATCH_IDS:-}
BATCH_LIMIT=${BATCH_LIMIT:-}
BATCH_CHAIN=${BATCH_CHAIN:-1}

DEFAULT_TOOLS_STRING=${DEFAULT_TOOLS_STRING:-abritamr amrfinderplus bracken checkm mlst plasmidfinder}
ADDITIONAL_TOOLS_STRING=${ADDITIONAL_TOOLS_STRING:-defensefinder ectyper ismapper mashdist mobsuite mykrobe phispy shigapass shigatyper shigeifinder}
