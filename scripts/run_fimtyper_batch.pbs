#!/bin/bash
#PBS -P rg42
#PBS -q normal
#PBS -l walltime=48:00:00
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l jobfs=100GB
#PBS -l storage=scratch/rg42+gdata/rg42
#PBS -N fimtyper_batch
#PBS -l wd

set -euo pipefail

PROJECT=${PROJECT:-rg42}
USER_NAME=${USER_NAME:-$USER}

BASE_DIR=${BASE_DIR:-/g/data/${PROJECT}/${USER_NAME}/agar_bactopia_test}
RESULTS_MAIN=${RESULTS_MAIN:-}
RUN_LABEL=${RUN_LABEL:-fimtyper_${PBS_JOBID}}

FIMTYPER_PIPELINE=${FIMTYPER_PIPELINE:-}
FIMTYPER_CONFIG=${FIMTYPER_CONFIG:-}
MERGE_FIMTYPER_SCRIPT=${MERGE_FIMTYPER_SCRIPT:-}
FIMTYPER_PROFILE=${FIMTYPER_PROFILE:-}

SING_CACHE=${SING_CACHE:-/scratch/${PROJECT}/${USER_NAME}/singularity_cache}
RESULTS_ROOT=${RESULTS_ROOT:-/scratch/${PROJECT}/${USER_NAME}/bactopia_results}
RESULTS_OUT=${RESULTS_OUT:-${RESULTS_ROOT}/${RUN_LABEL}}
WORK_ROOT=${WORK_ROOT:-${RESULTS_ROOT}/_work/bactopia_fimtyper/${RUN_LABEL}}
SCRATCH_ROOT=${SCRATCH_ROOT:-$WORK_ROOT}
SCRATCH_RUN=${SCRATCH_ROOT}

if [[ -z "$RESULTS_MAIN" ]]; then
  echo "RESULTS_MAIN is required." >&2
  exit 1
fi

if [[ -z "$FIMTYPER_PIPELINE" || ! -f "$FIMTYPER_PIPELINE" ]]; then
  echo "FIMTYPER_PIPELINE not found: $FIMTYPER_PIPELINE" >&2
  exit 1
fi

if [[ -z "$FIMTYPER_CONFIG" || ! -f "$FIMTYPER_CONFIG" ]]; then
  echo "FIMTYPER_CONFIG not found: $FIMTYPER_CONFIG" >&2
  exit 1
fi

if [[ ! -d "$RESULTS_MAIN" ]]; then
  echo "RESULTS_MAIN not found: $RESULTS_MAIN" >&2
  exit 1
fi

# If the batch produced no assemblies (e.g. all samples were dropped at QC), there
# is nothing for FimTyper to type. Skip gracefully with a clear message instead of
# letting Nextflow abort on an empty input glob (checkIfExists).
shopt -s nullglob
_fimtyper_assemblies=("$RESULTS_MAIN"/*/main/assembler/*.fna.gz)
shopt -u nullglob
if [[ ${#_fimtyper_assemblies[@]} -eq 0 ]]; then
  echo "[fimtyper] No assemblies under $RESULTS_MAIN (*/main/assembler/*.fna.gz); skipping FimTyper for this batch." >&2
  mkdir -p "$RESULTS_OUT/results_fimtyper"
  exit 0
fi

mkdir -p "$SCRATCH_RUN" "$RESULTS_OUT" "$SING_CACHE"

if [[ "${USE_MODULES:-1}" == "1" ]]; then
  module purge
  module load nextflow
  module load singularity
fi

# Persist Nextflow's jar/capsule cache per-user (default $HOME/.nextflow) so the
# stage does not re-download Nextflow every run. Pin temp files to a stage-local
# dir so a bad TMPDIR/NXF_TEMP inherited from the caller's shell cannot break the
# run (NXF_TEMP wins over TMPDIR in Nextflow, so set both).
# Persistent, per-user Nextflow cache beside SING_CACHE -- not $HOME/.nextflow:
# on Gadi a full 10 GB home breaks both Nextflow startup and PBS stage-out.
export NXF_HOME="${NXF_HOME:-$(dirname "$SING_CACHE")/nextflow_home}"
export NXF_WORK="$SCRATCH_RUN/work"
export NXF_SINGULARITY_CACHEDIR="$SING_CACHE"
export SINGULARITY_CACHEDIR="$SING_CACHE"
export TMPDIR="$NXF_WORK/tmp"
export NXF_TEMP="$TMPDIR"
mkdir -p "$NXF_HOME" "$NXF_WORK" "$NXF_SINGULARITY_CACHEDIR" "$TMPDIR"

cd "$SCRATCH_RUN"

# Publish the Nextflow log even when the run fails. Under `set -e` a failed
# `nextflow run` exits before the rsync at the end of this script, and PBS's own
# .o/.e delivery is not guaranteed either (an over-quota $HOME silently drops it),
# which leaves a failed stage with no diagnosable trace at all. The EXIT trap
# copies whatever log exists into a location on the results tree; it does not
# change the stage's exit status.
NEXTFLOW_LOG_PUBLISH_DIR=${NEXTFLOW_LOG_PUBLISH_DIR:-$RESULTS_OUT}
publish_nextflow_log() {
  local rc=$?
  [[ -n ${NEXTFLOW_LOG_PUBLISH_DIR:-} ]] || return $rc
  mkdir -p "$NEXTFLOW_LOG_PUBLISH_DIR" 2>/dev/null || return $rc
  cp -f "$SCRATCH_RUN"/.nextflow.log* "$NEXTFLOW_LOG_PUBLISH_DIR/" 2>/dev/null || true
  return $rc
}
trap publish_nextflow_log EXIT


# Reused batch labels can leave stale sample directories from older runs.
rm -rf results_fimtyper

fimtyper_args=(
  --results_main "$RESULTS_MAIN"
  --outdir results_fimtyper
  -work-dir "${NXF_WORK}/fimtyper"
  -c "$FIMTYPER_CONFIG"
  # Without -resume a re-run repeats every sample, so a stage killed on walltime
  # could never make progress. Cached tasks are still re-published, so clearing
  # results_fimtyper above stays safe.
  -resume
)

if [[ -n "$FIMTYPER_PROFILE" ]]; then
  fimtyper_args+=(-profile "$FIMTYPER_PROFILE")
fi

nextflow run "$FIMTYPER_PIPELINE" "${fimtyper_args[@]}"

if [[ -n "$MERGE_FIMTYPER_SCRIPT" ]]; then
  if [[ ! -f "$MERGE_FIMTYPER_SCRIPT" ]]; then
    echo "MERGE_FIMTYPER_SCRIPT not found: $MERGE_FIMTYPER_SCRIPT" >&2
    exit 1
  fi
  bash "$MERGE_FIMTYPER_SCRIPT" results_fimtyper
fi

mkdir -p "$RESULTS_OUT/results_fimtyper"
rsync -av --delete results_fimtyper/ "$RESULTS_OUT/results_fimtyper/"
rsync -av .nextflow.log* "$RESULTS_OUT/" || true
