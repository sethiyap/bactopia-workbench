#!/bin/bash
#PBS -P rg42
#PBS -q normal
#PBS -l walltime=08:00:00
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/rg42+gdata/rg42
#PBS -N st131typer
#PBS -l wd

set -euo pipefail

ASSEMBLIES_DIR=${ASSEMBLIES_DIR:-}
RESULTS_ROOT=${RESULTS_ROOT:-${PBS_O_WORKDIR:-$PWD}}
ST131_TYPER_SCRIPT=${ST131_TYPER_SCRIPT:-}
ST131_TYPER_OUTPUT_DIR=${ST131_TYPER_OUTPUT_DIR:-${RESULTS_ROOT}/st131typer}
MLST_ENV=${MLST_ENV:-}

# ST131Typer.sh shells out to seqkit, which ships in MLST_ENV rather than on the
# default PATH. On PBS/Slurm only declared job variables are forwarded (no ambient
# shell), so put MLST_ENV/bin on PATH here and fail fast: ST131Typer's own seqkit
# check prints an error but exits 0, which would otherwise surface much later as a
# confusing "no summary.txt" failure.
if [[ -n "$MLST_ENV" && -d "$MLST_ENV/bin" ]]; then
  export PATH="${MLST_ENV}/bin:$PATH"
fi
if ! command -v seqkit >/dev/null 2>&1; then
  echo "seqkit not found on PATH. Set MLST_ENV to the conda env that provides seqkit (and mlst)." >&2
  exit 1
fi

if [[ -z "$ASSEMBLIES_DIR" || ! -d "$ASSEMBLIES_DIR" ]]; then
  echo "ASSEMBLIES_DIR not found: $ASSEMBLIES_DIR" >&2
  exit 1
fi

# If no assemblies were collected (e.g. all samples were dropped at QC), ST131Typer
# has nothing to type. Skip gracefully instead of failing later on an empty summary.
shopt -s nullglob
_st131_assemblies=("$ASSEMBLIES_DIR"/*.fna "$ASSEMBLIES_DIR"/*.fna.gz "$ASSEMBLIES_DIR"/*.fasta "$ASSEMBLIES_DIR"/*.fa)
shopt -u nullglob
if [[ ${#_st131_assemblies[@]} -eq 0 ]]; then
  echo "[st131typer] No assemblies in $ASSEMBLIES_DIR; skipping ST131Typer for this batch." >&2
  mkdir -p "$ST131_TYPER_OUTPUT_DIR"
  exit 0
fi

if [[ -z "$ST131_TYPER_SCRIPT" || ! -f "$ST131_TYPER_SCRIPT" ]]; then
  echo "ST131_TYPER_SCRIPT not found: $ST131_TYPER_SCRIPT" >&2
  exit 1
fi

mkdir -p "$ST131_TYPER_OUTPUT_DIR"

st131_stdout_log="${ST131_TYPER_OUTPUT_DIR}/st131typer.stdout.log"
st131_stderr_log="${ST131_TYPER_OUTPUT_DIR}/st131typer.stderr.log"
st131_summary="${ST131_TYPER_OUTPUT_DIR}/summary.txt"

echo "Running ST131Typer"
echo "ASSEMBLIES_DIR=$ASSEMBLIES_DIR"
echo "ST131_TYPER_OUTPUT_DIR=$ST131_TYPER_OUTPUT_DIR"
echo "ST131_TYPER_SCRIPT=$ST131_TYPER_SCRIPT"
echo "Found ST131Typer.sh at: $ST131_TYPER_SCRIPT"
echo "ST131 stdout log: $st131_stdout_log"
echo "ST131 stderr log: $st131_stderr_log"

bash "$ST131_TYPER_SCRIPT" -i "$ASSEMBLIES_DIR" -o "$ST131_TYPER_OUTPUT_DIR" \
  >"$st131_stdout_log" 2>"$st131_stderr_log"

if [[ ! -s "$st131_summary" ]]; then
  echo "ST131Typer finished without a non-empty summary.txt: $st131_summary" >&2
  echo "Inspect logs: $st131_stdout_log and $st131_stderr_log" >&2
  exit 1
fi
