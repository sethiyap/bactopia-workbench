def kleborateCompatScript = System.getenv('KLEBORATE_COMPAT_SCRIPT') ?: "${baseDir}/scripts/kleborate_232_compat.sh"
def singCache = System.getenv('SING_CACHE') ?: "/scratch/${System.getenv('USER') ?: 'unknown'}/singularity_cache"
def mlstContainer = System.getenv('MLST_CONTAINER') ?: "${singCache}/mlst-2.33.1--hdfd78af_0.sif"
def kleborateContainer = System.getenv('KLEBORATE_CONTAINER') ?: "${singCache}/kleborate-2.3.2--pyhdfd78af_0.img"
def slurmPartition = System.getenv('SLURM_PARTITION') ?: null
def slurmAccount = System.getenv('SLURM_ACCOUNT') ?: ''
def slurmClusterOptions = System.getenv('SLURM_CLUSTER_OPTIONS') ?: ''
def slurmBaseOptions = [slurmAccount ? "--account ${slurmAccount}" : '', slurmClusterOptions].findAll { it }.join(' ')

def commonBeforeScript = '''
export TERM="${TERM:-dumb}"
export SINGULARITYENV_TERM=dumb
'''

process {
  executor = 'slurm'
  if (slurmPartition) {
    queue = slurmPartition
  }
  cpus = 4
  memory = 16.GB
  time = 12.h
  maxForks = 4
  if (slurmBaseOptions) {
    clusterOptions = { slurmBaseOptions }
  }

  beforeScript = commonBeforeScript

  withName: /.*:ASSEMBLER($|:.*)/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
    if (slurmBaseOptions) {
      clusterOptions = { slurmBaseOptions }
    }
  }

  withName: /.*:MLST_MODULE/ {
    container = mlstContainer
  }

  // Upstream Bactopia bug: kraken-bracken-summary.py assumes a U (unclassified)
  // row that Kraken2 omits when 100% of a sample's reads classify, then does
  // None + float and exits 1. Make Bracken non-fatal so the tools stage still
  // completes -- cleanly-classified samples just get no Bracken output. (A
  // report-repair beforeScript, like the CheckM one, is the proper fix.)
  withName: /.*:BRACKEN:BRACKEN_MODULE/ {
    errorStrategy = 'ignore'
  }

  withName: /.*:KLEBORATE_MODULE/ {
    container = kleborateContainer
    beforeScript = commonBeforeScript + """
if [[ ! -f "${kleborateCompatScript}" ]]; then
  echo "KLEBORATE_COMPAT_SCRIPT not found: ${kleborateCompatScript}" >&2
  exit 1
fi

cp "${kleborateCompatScript}" ./kleborate
chmod +x ./kleborate

if [[ -f .command.sh ]]; then
  perl -0pi -e 's{(?<![./])\\bkleborate\\b}{./kleborate}g' .command.sh
fi

export KLEBORATE_REAL="/usr/local/bin/kleborate"
export SINGULARITYENV_KLEBORATE_REAL="/usr/local/bin/kleborate"
export PATH="$PWD:$PATH"
export SINGULARITYENV_PREPEND_PATH="\$PWD"
"""
  }

  withName: /.*:CHECKM:CHECKM_LINEAGEWF/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
    if (slurmBaseOptions) {
      clusterOptions = { slurmBaseOptions }
    }
    beforeScript = commonBeforeScript + """
export MPLCONFIGDIR="\${PWD}/.mplconfig"
mkdir -p "\$MPLCONFIGDIR"

if [[ -f .command.sh ]]; then
  python - <<'PY'
from pathlib import Path
path = Path('.command.sh')
text = path.read_text()
text = text.replace(
    'find ./results/ -name "*.faa" -or -name "*hmmer.analyze.txt" -or -name "*.fasta" | xargs gzip',
    'find ./results/ \\\\( -name "*.faa" -o -name "*hmmer.analyze.txt" -o -name "*.fasta" \\\\) -print0 | xargs -0 -r gzip || true'
)
text = text.replace('mv results/checkm.log ./', 'mv results/checkm.log ./ || true')
text = text.replace(
    'checkm: \$(echo \$(checkm -h 2>&1) | sed \\'s/.*CheckM v//;s/ .*\\\$//\\')',
    'checkm: \$( (checkm -h 2>&1 || true) | sed \\'s/.*CheckM v//;s/ .*\\\$//\\')'
)
path.write_text(text)
PY
fi
"""
  }
}

executor {
  queueSize = 8
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = singCache
  pullTimeout = '2h'
}

params {
  max_memory = 32.GB
  max_cpus = 4
  max_time = 24.h
}
