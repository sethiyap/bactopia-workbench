#!/bin/bash
#PBS -P rg42
#PBS -q normal
#PBS -l walltime=24:00:00
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l jobfs=150GB
#PBS -l storage=scratch/rg42+gdata/rg42
#PBS -N bactopia_batch
#PBS -l wd

set -euo pipefail

# Run one Bactopia batch on Gadi.
# Edit the user settings and submit once per batch:
#   qsub -v BATCH_ID=001 scripts/run_bactopia_batch.pbs

###############################################################################
# User settings
###############################################################################
PROJECT=${PROJECT:-rg42}
USER_NAME=${USER_NAME:-$USER}
BASE_DIR=${BASE_DIR:-/g/data/${PROJECT}/${USER_NAME}/agar_bactopia_test}
SAMPLESHEET_DIR=${SAMPLESHEET_DIR:-${BASE_DIR}/metadata/batches}
SAMPLESHEET_PREFIX=${SAMPLESHEET_PREFIX:-batch_bactopia}
BATCH_ID=${BATCH_ID:-001}
BATCH_INPUT_FILE=${BATCH_INPUT_FILE:-}

NEXTFLOW_CONFIG=${NEXTFLOW_CONFIG:-${BASE_DIR}/scripts/nextflow.gadi.all_tools.config}
BACTOPIA_PIPELINE=${BACTOPIA_PIPELINE:-/g/data/${PROJECT}/bactopia/bactopia}
DATASETS_CACHE=${DATASETS_CACHE:-/g/data/${PROJECT}/bactopia_datasets_custom}
SING_CACHE=${SING_CACHE:-/scratch/${PROJECT}/${USER_NAME}/singularity_cache}

# Optional Bactopia arguments.
GENOME_SIZE=${GENOME_SIZE:-}
EXTRA_ARGS_STRING=${EXTRA_ARGS_STRING:-}
BACTOPIA_INPUT_MODE=${BACTOPIA_INPUT_MODE:-illumina}
MEDAKA_ROUNDS=${MEDAKA_ROUNDS:-}
MEDAKA_MODEL=${MEDAKA_MODEL:-}
ONT_MINLENGTH=${ONT_MINLENGTH:-}
ONT_MINQUAL=${ONT_MINQUAL:-}
USE_PORECHOP=${USE_PORECHOP:-}
###############################################################################

RUN_LABEL=${SAMPLESHEET_PREFIX}_${BATCH_ID}
RESULTS_ROOT=${RESULTS_ROOT:-/scratch/${PROJECT}/${USER_NAME}/bactopia_results}
RESULTS_OUT=${RESULTS_OUT:-${GDATA_OUT:-${RESULTS_ROOT}/${RUN_LABEL}}}
WORK_ROOT=${WORK_ROOT:-${RESULTS_ROOT}/_work/bactopia_batches/${RUN_LABEL}}
SCRATCH_ROOT=${SCRATCH_ROOT:-$WORK_ROOT}
SCRATCH_RUN=${SCRATCH_ROOT}

if [[ -n "$BATCH_INPUT_FILE" ]]; then
  SAMPLESHEET=$BATCH_INPUT_FILE
else
  if [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv
  elif [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.fofn" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.fofn
  elif [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.tsv" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.tsv
  else
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv
  fi
fi

mkdir -p "$SCRATCH_RUN" "$RESULTS_OUT" "$SING_CACHE"

if [[ ! -f "$SAMPLESHEET" ]]; then
  echo "Batch samplesheet not found: $SAMPLESHEET" >&2
  exit 1
fi

if [[ ! -f "$NEXTFLOW_CONFIG" ]]; then
  echo "NEXTFLOW_CONFIG not found: $NEXTFLOW_CONFIG" >&2
  exit 1
fi

# Load tools via environment modules on module-based clusters (e.g. Gadi).
# Set USE_MODULES=0 (in the site config) when nextflow/singularity come from
# PATH or a conda env instead — then the job uses whatever is already on PATH.
if [[ "${USE_MODULES:-1}" == "1" ]]; then
  module purge
  module load nextflow
  module load singularity
fi

# NXF_HOME holds Nextflow's downloaded jar and capsule dependencies. Keep it in a
# persistent, per-user location (default $HOME/.nextflow) rather than the per-run
# scratch dir, so every batch does not re-download Nextflow -- which is both slow
# and a network failure mode. Overridable via NXF_HOME for sites with a shared cache.
export NXF_HOME="${NXF_HOME:-$HOME/.nextflow}"
export NXF_WORK="$SCRATCH_RUN/work"
export NXF_SINGULARITY_CACHEDIR="$SING_CACHE"
export SINGULARITY_CACHEDIR="$SING_CACHE"
# Force temp files into a stage-local dir so a bad TMPDIR / NXF_TEMP inherited from
# the caller's shell (e.g. a stale tmux session that points them at an unwritable or
# nonexistent path) cannot break the run. NXF_TEMP wins over TMPDIR inside Nextflow,
# so pin both to the same known-good, writable location.
export TMPDIR="$SCRATCH_RUN/tmp"
export NXF_TEMP="$TMPDIR"
mkdir -p "$NXF_HOME" "$NXF_WORK" "$NXF_SINGULARITY_CACHEDIR" "$TMPDIR"

cd "$SCRATCH_RUN"

EXTRA_ARGS=()
if [[ -n "${EXTRA_ARGS_STRING}" ]]; then
  # shellcheck disable=SC2206
  EXTRA_ARGS=(${EXTRA_ARGS_STRING})
fi

case "$BACTOPIA_INPUT_MODE" in
  illumina|ont|assembly)
    INPUT_ARGS=(--samples "$SAMPLESHEET")
    ;;
  accession)
    INPUT_ARGS=(--accessions "$SAMPLESHEET")
    ;;
  *)
    echo "Unsupported BACTOPIA_INPUT_MODE: $BACTOPIA_INPUT_MODE" >&2
    exit 1
    ;;
esac

ONT_ARGS=()
if [[ $BACTOPIA_INPUT_MODE == "ont" ]]; then
  [[ -n $MEDAKA_ROUNDS ]] && ONT_ARGS+=(--medaka_rounds "$MEDAKA_ROUNDS")
  [[ -n $MEDAKA_MODEL ]] && ONT_ARGS+=(--medaka_model "$MEDAKA_MODEL")
  [[ -n $ONT_MINLENGTH ]] && ONT_ARGS+=(--ont_minlength "$ONT_MINLENGTH")
  [[ -n $ONT_MINQUAL ]] && ONT_ARGS+=(--ont_minqual "$ONT_MINQUAL")
  [[ $USE_PORECHOP == "1" ]] && ONT_ARGS+=(--use_porechop)
fi

# genome_size is the EXPECTED genome size in bp and must be realistic. Bactopia uses
# it for two things: the coverage QC gate (Bactopia's --min_coverage, default 10, so
# it needs >= 10 x genome_size basepairs) AND the rasusa subsample target (coverage x
# genome_size). A tiny value like 1 does NOT disable QC -- it makes rasusa subsample
# every sample down to a few bases, which then fails Bactopia's absolute
# --min_basepairs / --min_reads floors. So 0 and 1 destroy the reads; only a realistic
# size is valid. Unset falls back to 5 Mb. To assemble shallow samples anyway, relax
# the gates with EXTRA_ARGS_STRING="--coverage 0 --min_coverage 0 --min_basepairs 0
# --min_reads 0" -- --min_coverage 0 is what disables the "10x coverage" gate.
if [[ -z $GENOME_SIZE ]]; then
  GENOME_SIZE=5000000
elif [[ $GENOME_SIZE == "0" ]]; then
  echo "GENOME_SIZE=0 is invalid: Bactopia subsamples reads to (coverage x genome_size), so 0 shrinks every sample to ~0 bp and then fails QC -- it does NOT disable the gate. Pass a realistic size (e.g. --genome-size 5000000), or relax QC with EXTRA_ARGS_STRING='--coverage 0 --min_coverage 0 --min_basepairs 0 --min_reads 0'." >&2
  exit 1
fi
GENOME_SIZE_ARGS=(--genome_size "$GENOME_SIZE")

printf 'Bactopia input mode: %s\n' "$BACTOPIA_INPUT_MODE"
printf 'Bactopia input manifest: %s\n' "$SAMPLESHEET"

BACTOPIA_CMD=(
  nextflow run "$BACTOPIA_PIPELINE"
  "${INPUT_ARGS[@]}"
  --datasets_cache "$DATASETS_CACHE"
  --outdir results_main
  -profile singularity
  -work-dir "$NXF_WORK"
  -c "$NEXTFLOW_CONFIG"
  -resume
)
if [[ ${#GENOME_SIZE_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${GENOME_SIZE_ARGS[@]}")
fi
if [[ ${#ONT_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${ONT_ARGS[@]}")
fi
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${EXTRA_ARGS[@]}")
fi

printf 'Bactopia command:'
printf ' %q' "${BACTOPIA_CMD[@]}"
printf '\n'
"${BACTOPIA_CMD[@]}"

rsync -av results_main/ "$RESULTS_OUT/results_main/"
rsync -av .nextflow.log* "$RESULTS_OUT/" || true

# --- Per-sample input-read coverage flag -------------------------------------
# Write each sample's coverage (input basepairs / expected genome size) so the
# consolidator/mapper can surface a low-coverage flag in the results sheet. When QC
# gates are relaxed (EXTRA_ARGS_STRING="--coverage 0 ...") shallow samples still
# assemble, and this is how they stay identifiable. Computed from the FOFN
# (sample<TAB>runtype<TAB>r1<TAB>r2<TAB>extra), not Bactopia's internal layout, so it
# is robust; it uses input reads, which run slightly higher than post-QC, so it is a
# flag rather than a QC gate. Best-effort: never fail the job over this.
LOW_COVERAGE_THRESHOLD=${LOW_COVERAGE_THRESHOLD:-10}
coverage_summary="${RESULTS_OUT}/coverage_summary.tsv"
if [[ -f "$SAMPLESHEET" && "$GENOME_SIZE" =~ ^[1-9][0-9]*$ ]]; then
  {
    printf 'sample\tinput_total_bp\tgenome_size\tcoverage_x\tlow_coverage\n'
    tail -n +2 "$SAMPLESHEET" | while IFS=$'\t' read -r csample cruntype cr1 cr2 cextra; do
      [[ -z "$csample" ]] && continue
      ctotal=0
      for cfq in "$cr1" "$cr2"; do
        [[ -n "$cfq" && -f "$cfq" ]] || continue
        cbp=$(zcat -f -- "$cfq" 2>/dev/null | awk 'NR%4==2{b+=length($0)} END{printf "%d", b+0}')
        ctotal=$((ctotal + cbp))
      done
      if [[ "$ctotal" -gt 0 ]]; then
        ccov=$(awk -v b="$ctotal" -v g="$GENOME_SIZE" 'BEGIN{printf "%.2f", b/g}')
        clow=$(awk -v c="$ccov" -v t="$LOW_COVERAGE_THRESHOLD" 'BEGIN{print (c+0 < t+0 ? "yes" : "no")}')
      else
        ccov=NA
        clow=NA
      fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$csample" "$ctotal" "$GENOME_SIZE" "$ccov" "$clow"
    done
  } > "$coverage_summary" 2>/dev/null || true
  printf 'Wrote input-read coverage summary: %s\n' "$coverage_summary" >&2
fi
