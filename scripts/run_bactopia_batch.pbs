#!/bin/bash
#PBS -P rg42
#PBS -q normal
#PBS -l walltime=24:00:00
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l jobfs=150GB
#PBS -l storage=scratch/rg42+gdata/rg42
#PBS -N bactopia_batch
#PBS -l wd

set -euo pipefail

# Run one Bactopia batch on Gadi.
# Edit the user settings and submit once per batch:
#   qsub -v BATCH_ID=001 scripts/run_bactopia_batch.pbs

###############################################################################
# User settings
###############################################################################
PROJECT=${PROJECT:-rg42}
USER_NAME=${USER_NAME:-$USER}
BASE_DIR=${BASE_DIR:-/g/data/${PROJECT}/${USER_NAME}/agar_bactopia_test}
SAMPLESHEET_DIR=${SAMPLESHEET_DIR:-${BASE_DIR}/metadata/batches}
SAMPLESHEET_PREFIX=${SAMPLESHEET_PREFIX:-batch_bactopia}
BATCH_ID=${BATCH_ID:-001}
BATCH_INPUT_FILE=${BATCH_INPUT_FILE:-}

NEXTFLOW_CONFIG=${NEXTFLOW_CONFIG:-${BASE_DIR}/scripts/nextflow.gadi.all_tools.config}
BACTOPIA_PIPELINE=${BACTOPIA_PIPELINE:-/g/data/${PROJECT}/bactopia/bactopia}
DATASETS_CACHE=${DATASETS_CACHE:-/g/data/${PROJECT}/bactopia_datasets_custom}
SING_CACHE=${SING_CACHE:-/scratch/${PROJECT}/${USER_NAME}/singularity_cache}

# Optional Bactopia arguments.
GENOME_SIZE=${GENOME_SIZE:-}
EXTRA_ARGS_STRING=${EXTRA_ARGS_STRING:-}
BACTOPIA_INPUT_MODE=${BACTOPIA_INPUT_MODE:-illumina}
MEDAKA_ROUNDS=${MEDAKA_ROUNDS:-}
MEDAKA_MODEL=${MEDAKA_MODEL:-}
ONT_MINLENGTH=${ONT_MINLENGTH:-}
ONT_MINQUAL=${ONT_MINQUAL:-}
USE_PORECHOP=${USE_PORECHOP:-}
###############################################################################

RUN_LABEL=${SAMPLESHEET_PREFIX}_${BATCH_ID}
RESULTS_ROOT=${RESULTS_ROOT:-/scratch/${PROJECT}/${USER_NAME}/bactopia_results}
RESULTS_OUT=${RESULTS_OUT:-${GDATA_OUT:-${RESULTS_ROOT}/${RUN_LABEL}}}
WORK_ROOT=${WORK_ROOT:-${RESULTS_ROOT}/_work/bactopia_batches/${RUN_LABEL}}
SCRATCH_ROOT=${SCRATCH_ROOT:-$WORK_ROOT}
SCRATCH_RUN=${SCRATCH_ROOT}

if [[ -n "$BATCH_INPUT_FILE" ]]; then
  SAMPLESHEET=$BATCH_INPUT_FILE
else
  if [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv
  elif [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.fofn" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.fofn
  elif [[ -f "${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.tsv" ]]; then
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.tsv
  else
    SAMPLESHEET=${SAMPLESHEET_DIR}/${SAMPLESHEET_PREFIX}_${BATCH_ID}.csv
  fi
fi

mkdir -p "$SCRATCH_RUN" "$RESULTS_OUT" "$SING_CACHE"

if [[ ! -f "$SAMPLESHEET" ]]; then
  echo "Batch samplesheet not found: $SAMPLESHEET" >&2
  exit 1
fi

if [[ ! -f "$NEXTFLOW_CONFIG" ]]; then
  echo "NEXTFLOW_CONFIG not found: $NEXTFLOW_CONFIG" >&2
  exit 1
fi

# Load tools via environment modules on module-based clusters (e.g. Gadi).
# Set USE_MODULES=0 (in the site config) when nextflow/singularity come from
# PATH or a conda env instead — then the job uses whatever is already on PATH.
if [[ "${USE_MODULES:-1}" == "1" ]]; then
  module purge
  module load nextflow
  module load singularity
fi

export NXF_HOME="$SCRATCH_RUN/.nextflow"
export NXF_WORK="$SCRATCH_RUN/work"
export NXF_SINGULARITY_CACHEDIR="$SING_CACHE"
export SINGULARITY_CACHEDIR="$SING_CACHE"
mkdir -p "$NXF_HOME" "$NXF_WORK" "$NXF_SINGULARITY_CACHEDIR"

cd "$SCRATCH_RUN"

EXTRA_ARGS=()
if [[ -n "${EXTRA_ARGS_STRING}" ]]; then
  # shellcheck disable=SC2206
  EXTRA_ARGS=(${EXTRA_ARGS_STRING})
fi

case "$BACTOPIA_INPUT_MODE" in
  illumina|ont|assembly)
    INPUT_ARGS=(--samples "$SAMPLESHEET")
    ;;
  accession)
    INPUT_ARGS=(--accessions "$SAMPLESHEET")
    ;;
  *)
    echo "Unsupported BACTOPIA_INPUT_MODE: $BACTOPIA_INPUT_MODE" >&2
    exit 1
    ;;
esac

ONT_ARGS=()
if [[ $BACTOPIA_INPUT_MODE == "ont" ]]; then
  [[ -n $MEDAKA_ROUNDS ]] && ONT_ARGS+=(--medaka_rounds "$MEDAKA_ROUNDS")
  [[ -n $MEDAKA_MODEL ]] && ONT_ARGS+=(--medaka_model "$MEDAKA_MODEL")
  [[ -n $ONT_MINLENGTH ]] && ONT_ARGS+=(--ont_minlength "$ONT_MINLENGTH")
  [[ -n $ONT_MINQUAL ]] && ONT_ARGS+=(--ont_minqual "$ONT_MINQUAL")
  [[ $USE_PORECHOP == "1" ]] && ONT_ARGS+=(--use_porechop)
fi

# Genome size drives Bactopia's coverage QC gate (min basepairs = genome_size x 10).
# Bactopia 3.2.0 has NO auto-estimate and NO default for genome_size: it must reach
# Bactopia as a truthy integer, or the QC module interpolates a null and aborts the
# job with "null: unbound variable". An empty value AND 0 are both falsy and trigger
# that crash, so they are resolved to a concrete size here before Bactopia sees it:
#   - an explicit positive size is passed through (real coverage gate);
#   - ONT with no size defaults to 1, matching Bactopia's teton/clean-yer-reads
#     profiles: 10 x 1 = 10 bp effectively disables the coverage gate so shallow ONT
#     data still assembles. Treat such assemblies as provisional and pass
#     --genome-size N (e.g. 6300000 for P. aeruginosa) for a real gate;
#   - short-read/assembly input keeps the historical 5 Mb default.
if [[ -z $GENOME_SIZE || $GENOME_SIZE == "0" ]]; then
  if [[ $BACTOPIA_INPUT_MODE == "ont" ]]; then
    GENOME_SIZE=1
    echo "GENOME_SIZE unset for ONT input; defaulting to 1 (coverage gate disabled). Pass --genome-size N for a real coverage gate." >&2
  else
    GENOME_SIZE=5000000
  fi
fi
GENOME_SIZE_ARGS=(--genome_size "$GENOME_SIZE")

printf 'Bactopia input mode: %s\n' "$BACTOPIA_INPUT_MODE"
printf 'Bactopia input manifest: %s\n' "$SAMPLESHEET"

BACTOPIA_CMD=(
  nextflow run "$BACTOPIA_PIPELINE"
  "${INPUT_ARGS[@]}"
  --datasets_cache "$DATASETS_CACHE"
  --outdir results_main
  -profile singularity
  -work-dir "$NXF_WORK"
  -c "$NEXTFLOW_CONFIG"
  -resume
)
if [[ ${#GENOME_SIZE_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${GENOME_SIZE_ARGS[@]}")
fi
if [[ ${#ONT_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${ONT_ARGS[@]}")
fi
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
  BACTOPIA_CMD+=("${EXTRA_ARGS[@]}")
fi

printf 'Bactopia command:'
printf ' %q' "${BACTOPIA_CMD[@]}"
printf '\n'
"${BACTOPIA_CMD[@]}"

rsync -av results_main/ "$RESULTS_OUT/results_main/"
rsync -av .nextflow.log* "$RESULTS_OUT/" || true
