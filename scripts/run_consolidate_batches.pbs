#!/bin/bash
#PBS -P rg42
#PBS -q normal
#PBS -l walltime=04:00:00
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/rg42+gdata/rg42
#PBS -N merge_bactopia_results
#PBS -l wd

set -euo pipefail

PROJECT=${PROJECT:-rg42}
USER_NAME=${USER_NAME:-$USER}
# Example B05 submission:
# qsub -v "RESULTS_ROOT=/scratch/<project>/<user>/run_001,BATCH_PREFIX=batch_bactopia,CONSOLIDATED_OUTDIR=/scratch/<project>/<user>/run_001/batch_bactopia_consolidated,CONSOLIDATE_SCRIPT=/path/to/consolidate_bactopia_batches.R" scripts/run_consolidate_batches.pbs

RESULTS_ROOT=${RESULTS_ROOT:-/scratch/${PROJECT}/${USER_NAME}/bactopia_results}
BATCH_PREFIX=${BATCH_PREFIX:-batch_bactopia}
CONSOLIDATED_OUTDIR=${CONSOLIDATED_OUTDIR:-${RESULTS_ROOT}/${BATCH_PREFIX}_consolidated}
CONSOLIDATE_SCRIPT=${CONSOLIDATE_SCRIPT:-${BASE_DIR:-$PWD}/scripts/consolidate_bactopia_batches.R}

if [[ ! -f "$CONSOLIDATE_SCRIPT" ]]; then
  echo "CONSOLIDATE_SCRIPT not found: $CONSOLIDATE_SCRIPT" >&2
  exit 1
fi

if [[ ! -d "$RESULTS_ROOT" ]]; then
  echo "RESULTS_ROOT not found: $RESULTS_ROOT" >&2
  exit 1
fi

if [[ "${USE_MODULES:-1}" == "1" ]]; then
  module purge
  module load R
fi

Rscript "$CONSOLIDATE_SCRIPT" \
  --results-root "$RESULTS_ROOT" \
  --batch-prefix "$BATCH_PREFIX" \
  --output-dir "$CONSOLIDATED_OUTDIR"

# Collect per-sample task failures from every stage's Nextflow trace into the
# consolidated directory, where map_samplesheet_results.R picks them up as the
# `failed_steps` / `failure_reason` columns. Per-sample tool modules carry
# errorStrategy 'ignore' (see nextflow.*.all_tools.config), so without this a failed
# sample is indistinguishable from one the tool simply had nothing to say about.
#
# Runs after consolidation because it writes into CONSOLIDATED_OUTDIR, and is
# strictly best-effort: this is diagnostics, and it must never fail a consolidation
# that otherwise succeeded.
FAILURES_SCRIPT=${FAILURES_SCRIPT:-${BASE_DIR:-$PWD}/scripts/collect_pipeline_failures.py}
FAILURES_PYTHON=${FAILURES_PYTHON:-python3}
if [[ -f "$FAILURES_SCRIPT" ]]; then
  if ! "$FAILURES_PYTHON" "$FAILURES_SCRIPT" \
      --results-root "$RESULTS_ROOT" \
      --output "${CONSOLIDATED_OUTDIR}/pipeline_failures.tsv"; then
    echo "WARNING: collecting pipeline failures failed; results will not carry failure reasons." >&2
  fi
else
  echo "WARNING: collect_pipeline_failures.py not found: $FAILURES_SCRIPT (results will not carry failure reasons)" >&2
fi
