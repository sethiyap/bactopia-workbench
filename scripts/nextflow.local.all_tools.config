// Nextflow config for the scheduler-free "local" backend.
// Bactopia's processes run as local subprocesses (executor = 'local') inside
// Singularity containers — no qsub/sbatch is ever invoked. Based on
// nextflow.slurm.all_tools.config with the Slurm executor/queue removed.
//
// Tune concurrency/resources for the host with LOCAL_MAX_CPUS, LOCAL_MAX_MEMORY,
// and LOCAL_MAX_FORKS (all optional).

def kleborateCompatScript = System.getenv('KLEBORATE_COMPAT_SCRIPT') ?: "${baseDir}/scripts/kleborate_232_compat.sh"
def krakenFixScript = System.getenv('KRAKEN_FIX_SCRIPT') ?: (System.getenv('BASE_DIR') ? "${System.getenv('BASE_DIR')}/scripts/kraken_report_fix.sh" : "${baseDir}/scripts/kraken_report_fix.sh")
def checkmFixScript = System.getenv('CHECKM_FIX_SCRIPT') ?: (System.getenv('BASE_DIR') ? "${System.getenv('BASE_DIR')}/scripts/checkm_command_fix.sh" : "${baseDir}/scripts/checkm_command_fix.sh")
def singCache = System.getenv('SING_CACHE') ?: "${System.getenv('HOME')}/singularity_cache"
// Default to registry URIs (not local .sif paths) so Nextflow pulls the images
// into SING_CACHE on first use. A bare filesystem path that does not exist is a
// hard error, whereas a URI is fetched automatically. Override MLST_CONTAINER /
// KLEBORATE_CONTAINER with a local .sif if you pre-stage images for offline hosts.
def mlstContainer = System.getenv('MLST_CONTAINER') ?: "quay.io/biocontainers/mlst:2.33.1--hdfd78af_0"
def kleborateContainer = System.getenv('KLEBORATE_CONTAINER') ?: "quay.io/biocontainers/kleborate:2.3.2--pyhdfd78af_0"

def localMaxCpus = (System.getenv('LOCAL_MAX_CPUS') ?: '4') as int
def localMaxMemory = "${System.getenv('LOCAL_MAX_MEMORY') ?: '16.GB'}"
def localMaxForks = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int

def commonBeforeScript = '''
export TERM="${TERM:-dumb}"
'''

process {
  executor = 'local'
  cpus = 4
  memory = 16.GB
  time = 12.h
  maxForks = localMaxForks

  // A transient Singularity failure -- most commonly
  //   "failed to find loop device ... resource temporarily unavailable"
  // when several containers mount on the same node at once -- should not kill the
  // whole stage. Nextflow reports a container creation failure as exit 255. Retry
  // those a few times (with the pbspro/slurm executors each retry is a fresh
  // scheduler job, so there is natural delay before the next attempt) and leave
  // every other failure to Nextflow's default terminate behaviour.
  errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
  maxRetries = 3

  beforeScript = commonBeforeScript

  withName: /.*:ASSEMBLER($|:.*)/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
  }

  withName: /BACTOPIATOOLS:.*:MLST_MODULE/ {
    container = mlstContainer
  }

  // Upstream Bactopia bug: kraken-bracken-summary.py reads the unclassified count
  // from the Kraken2 report's U row and does None + float, but Kraken2 omits the U
  // row when 100% of a sample's reads classify, aborting the task (.command.sh runs
  // under bash -ue). The beforeScript patches .command.sh to prepend a zero U row to
  // the report (scripts/kraken_report_fix.sh) before the summary runs, so every
  // sample keeps its Bracken result. errorStrategy stays as a safety net in case a
  // future Bactopia version changes the invocation and the patch no-ops.
  withName: /.*:BRACKEN:BRACKEN_MODULE/ {
    errorStrategy = 'ignore'
    beforeScript = commonBeforeScript + """
if [[ -f "${krakenFixScript}" ]]; then
  cp "${krakenFixScript}" ./kraken_report_fix.sh
  chmod +x ./kraken_report_fix.sh
  if [[ -f .command.sh ]]; then
    perl -0pi -e 's{kraken-bracken-summary.py}{bash ./kraken_report_fix.sh || true; kraken-bracken-summary.py} unless /kraken_report_fix/' .command.sh
  fi
else
  echo "kraken_report_fix.sh not found: ${krakenFixScript} (Bracken may crash on 100%-classified samples)" >&2
fi
"""
  }

  withName: /.*:KLEBORATE_MODULE/ {
    container = kleborateContainer
    beforeScript = commonBeforeScript + """
if [[ ! -f "${kleborateCompatScript}" ]]; then
  echo "KLEBORATE_COMPAT_SCRIPT not found: ${kleborateCompatScript}" >&2
  exit 1
fi

cp "${kleborateCompatScript}" ./kleborate
chmod +x ./kleborate

if [[ -f .command.sh ]]; then
  perl -0pi -e 's{(?<![./])\\bkleborate\\b}{./kleborate}g' .command.sh
fi

# KLEBORATE_REAL -- the real binary the wrapper exec's -- is set in the `env` scope
# (see the note there); exporting it here would never reach the container. PATH is
# the one variable nxf_launch forwards, and the perl rewrite above already makes
# the wrapper explicit (./kleborate), so this is only belt-and-braces.
export PATH="$PWD:$PATH"
"""
  }

  withName: /.*:CHECKM:CHECKM_LINEAGEWF/ {
    cpus = 4
    memory = 32.GB
    time = 24.h
    beforeScript = commonBeforeScript + """
export MPLCONFIGDIR="\${PWD}/.mplconfig"
mkdir -p "\$MPLCONFIGDIR"
if [[ -f "${checkmFixScript}" ]]; then
  cp "${checkmFixScript}" ./checkm_command_fix.sh
  bash ./checkm_command_fix.sh || true
else
  echo "checkm_command_fix.sh not found: ${checkmFixScript} (CheckM may fail on empty find/gzip or missing checkm.log)" >&2
fi
"""
  }

  withName: /.*:DEFENSEFINDER:.*/ {
    // DefenseFinder (1.3.0 under Bactopia 3.2.0) queries GitHub for a newer model
    // version on every run, with no flag to skip it, so across many samples it
    // exhausts GitHub's unauthenticated hourly rate limit and aborts with
    // MacsyDataLimitError. Make it non-fatal so the tools stage still completes;
    // samples that reach GitHub still get results. Scoped to the whole subworkflow
    // rather than DEFENSEFINDER_RUN alone: DEFENSEFINDER_UPDATE makes the same
    // query, and where there is no outbound internet at all it dies first.
    //
    // This does NOT cover a missing container image. Nextflow pulls images from the
    // driver, before any task is submitted, so a failed pull aborts the session with
    // Exit Code: null and ignoredCount=0 -- no withName: directive can reach it. The
    // image has to be pre-staged (scripts/repair_singularity_cache.sh) for this
    // errorStrategy to ever get a say.
    errorStrategy = 'ignore'
  }

  // Organism-specific typers error (rather than return empty) when their target
  // species is absent. Make them non-fatal so a non-target or mixed run still
  // completes; when the organism IS present they run and produce results normally.
  withName: /.*:(ECTYPER|SHIGATYPER|SHIGEIFINDER|SHIGAPASS).*/ {
    errorStrategy = 'ignore'
  }
}

executor {
  // Cap total concurrent local processes so a single host is not overwhelmed.
  // The local executor admits tasks against cpus AND memory; without an explicit
  // memory cap it admits against the host's total RAM, so LOCAL_MAX_MEMORY would
  // not actually limit concurrency. Set it here so the memory cap is enforced.
  queueSize = localMaxForks
  cpus = localMaxCpus
  memory = localMaxMemory
}

// Container environment.
//
// IMPORTANT: this MUST be the `env` scope. Nextflow's nxf_launch runs
//     env - PATH="$PATH" ... singularity exec --no-home --pid ...
// so `env -` wipes the environment before the container starts. Nothing a
// beforeScript exports reaches the container -- SINGULARITYENV_* included, since
// Singularity never sees those variables either. Only the `env` scope survives:
// Nextflow emits it into nxf_container_env(), which is eval'd inside the
// container. PATH is the single exception, forwarded explicitly by nxf_launch.
//
// JAVA_TOOL_OPTIONS: every container runs with `--pid`, so each task gets its own
// PID namespace and JVM PIDs restart low, while the host /tmp is shared into all
// of them. Concurrent Java tools then collide on /tmp/hsperfdata_$USER/<pid> and
// the loser prints a "[warning][perf,memops]" line on stdout. Prokka 1.14.6 reads
// its minced version with `minced --version | sed -n '1p'` (no 2>&1), parses the
// warning instead of the version, and aborts the task. Disabling the perf-data
// file removes the collision. (The JVM's own "Picked up JAVA_TOOL_OPTIONS" notice
// goes to stderr, so it cannot be mistaken for a version by the same parse.)
// Measured locally: 12 concurrent containers -> 9 failures without the flag,
// 12/12 clean with it. Set on every site config, not just local -- Nextflow passes
// --pid regardless of executor, so on slurm/gadi this fires for co-scheduled tasks
// on the same node, as an intermittent rather than reliable failure.
//
// TERM / KLEBORATE_REAL: previously exported as SINGULARITYENV_* from
// beforeScript, where they were silently no-ops.
env {
  JAVA_TOOL_OPTIONS = '-XX:-UsePerfData'
  TERM = 'dumb'
  KLEBORATE_REAL = System.getenv('KLEBORATE_REAL') ?: '/usr/local/bin/kleborate'
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = singCache
  pullTimeout = '2h'
}

params {
  max_memory = localMaxMemory
  max_cpus = localMaxCpus
  max_time = 24.h
}
