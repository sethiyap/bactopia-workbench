// FIMTYPER is a ~1 minute, 1 CPU perl/BLAST task per sample. Submitting each one
// as its own scheduler job means the head job sits idle in the queue -- a 50-sample
// batch can exhaust its walltime waiting rather than computing. So run them inside
// the CPUs the head job already holds. Set FIMTYPER_EXECUTOR=pbspro to restore
// per-sample scheduler submission.
def fimtyperExecutor = System.getenv('FIMTYPER_EXECUTOR') ?: 'local'
def fimtyperForks = (System.getenv('FIMTYPER_MAX_FORKS') ?: '4') as int

process {
  executor = fimtyperExecutor
  queue = 'normal'
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = fimtyperForks

  // A transient Singularity failure -- most commonly
  //   "failed to find loop device ... resource temporarily unavailable"
  // when several containers mount on the same node at once -- should not kill the
  // whole stage. Nextflow reports a container creation failure as exit 255. Retry
  // those a few times (under pbspro/slurm each retry is a fresh scheduler job, so
  // there is natural delay before the next attempt) and leave every other failure
  // to Nextflow's default terminate behaviour.
  errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
  maxRetries = 3
  clusterOptions = { "-P rg42 -l ncpus=${task.cpus},mem=${task.memory.toMega()}mb,walltime=04:00:00,storage=scratch/rg42+gdata/rg42" }

  beforeScript = '''
module purge
module load singularity
'''

  withName: 'FIMTYPER' {
    // Gadi compute nodes have no internet, so this defaults to a pre-staged .sif
    // (rg42's). Other Gadi projects: pre-pull the published image on a login node
    // into SING_CACHE and set FIMTYPER_CONTAINER to it.
    container = System.getenv('FIMTYPER_CONTAINER') ?: '/g/data/rg42/bactopia/caches/singularity/fimtyper.sif'
  }
}

executor {
  queueSize = fimtyperForks
}

// TERM must be set in the `env` scope, not exported from beforeScript: Nextflow's
// nxf_launch runs `env - PATH="$PATH" ... singularity exec ...`, so `env -` wipes
// the environment and nothing a beforeScript exports (SINGULARITYENV_* included)
// reaches the container. Only `env` entries survive -- Nextflow emits them into
// nxf_container_env(), which is eval'd inside. FimTyper's perl/BLAST tools warn
// when TERM is unset. (No JAVA_TOOL_OPTIONS here: this stage runs no JVM tool --
// see the note in the all_tools configs.)
env {
  TERM = 'dumb'
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/g/data/rg42/bactopia/caches/singularity'
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}

