process {
  executor = 'pbspro'
  queue = 'normal'
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = 8

  // A transient Singularity failure -- most commonly
  //   "failed to find loop device ... resource temporarily unavailable"
  // when several containers mount on the same node at once -- should not kill the
  // whole stage. Nextflow reports a container creation failure as exit 255. Retry
  // those a few times (with the pbspro/slurm executors each retry is a fresh
  // scheduler job, so there is natural delay before the next attempt) and leave
  // every other failure to Nextflow's default terminate behaviour.
  errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
  maxRetries = 3
  clusterOptions = { "-P rg42 -l ncpus=${task.cpus},mem=${task.memory.toMega()}mb,walltime=04:00:00,storage=scratch/rg42+gdata/rg42" }

  beforeScript = '''
module purge
module load singularity
'''

  withName: 'FIMTYPER' {
    // Gadi compute nodes have no internet, so this defaults to a pre-staged .sif
    // (rg42's). Other Gadi projects: pre-pull the published image on a login node
    // into SING_CACHE and set FIMTYPER_CONTAINER to it.
    container = System.getenv('FIMTYPER_CONTAINER') ?: '/g/data/rg42/bactopia/caches/singularity/fimtyper.sif'
  }
}

executor {
  queueSize = 8
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = '/g/data/rg42/bactopia/caches/singularity'
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}

