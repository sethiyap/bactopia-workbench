// FimTyper Nextflow config for the scheduler-free "local" backend.
// process.executor = 'local' so FimTyper runs as a local subprocess (no sbatch/qsub).
// Based on fimtyper.slurm.config with the Slurm executor/queue/clusterOptions removed.

def singCache = System.getenv('SING_CACHE') ?: "${System.getenv('HOME')}/singularity_cache"

// FIMTYPER_DIR set => run FimTyper natively from that checkout (see fimtyper.nf),
// so no container engine is needed and the `container` directive below is ignored.
// Unset it to fall back to pulling the published image.
def fimtyperNative = (System.getenv('FIMTYPER_DIR') ?: '') as boolean

process {
  executor = 'local'
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int

  beforeScript = '''
export TERM="${TERM:-dumb}"
export SINGULARITYENV_TERM=dumb
'''

  withName: 'FIMTYPER' {
    // Auto-pulled from GHCR (published image) so no external install is needed.
    // Override with a local .sif via FIMTYPER_CONTAINER for offline hosts.
    container = System.getenv('FIMTYPER_CONTAINER') ?: 'docker://ghcr.io/sethiyap/agar-bactopia-fimtyper:1.2'
  }
}

executor {
  queueSize = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int
  cpus = (System.getenv('LOCAL_MAX_CPUS') ?: '4') as int
}

singularity {
  enabled = !fimtyperNative
  autoMounts = true
  cacheDir = singCache
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}
