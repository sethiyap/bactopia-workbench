// FimTyper Nextflow config for the scheduler-free "local" backend.
// process.executor = 'local' so FimTyper runs as a local subprocess (no sbatch/qsub).
// Based on fimtyper.slurm.config with the Slurm executor/queue/clusterOptions removed.

def singCache = System.getenv('SING_CACHE') ?: "${System.getenv('HOME')}/singularity_cache"

// FIMTYPER_DIR set => run FimTyper natively from that checkout (see fimtyper.nf),
// so no container engine is needed and the `container` directive below is ignored.
// Unset it to fall back to pulling the published image.
def fimtyperNative = (System.getenv('FIMTYPER_DIR') ?: '') as boolean

process {
  executor = 'local'
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int

  // A transient Singularity failure -- most commonly
  //   "failed to find loop device ... resource temporarily unavailable"
  // when several containers mount on the same node at once -- should not kill the
  // whole stage. Nextflow reports a container creation failure as exit 255. Retry
  // those a few times (with the pbspro/slurm executors each retry is a fresh
  // scheduler job, so there is natural delay before the next attempt) and leave
  // every other failure to Nextflow's default terminate behaviour.
  errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
  maxRetries = 3

  beforeScript = '''
export TERM="${TERM:-dumb}"
'''

  withName: 'FIMTYPER' {
    // Auto-pulled from GHCR (published image) so no external install is needed.
    // Override with a local .sif via FIMTYPER_CONTAINER for offline hosts.
    container = System.getenv('FIMTYPER_CONTAINER') ?: 'docker://ghcr.io/sethiyap/agar-bactopia-fimtyper:1.2'
  }
}

executor {
  queueSize = (System.getenv('LOCAL_MAX_FORKS') ?: '2') as int
  cpus = (System.getenv('LOCAL_MAX_CPUS') ?: '4') as int
}

// TERM must be set in the `env` scope, not exported from beforeScript: Nextflow's
// nxf_launch runs `env - PATH="$PATH" ... singularity exec ...`, so `env -` wipes
// the environment and nothing a beforeScript exports (SINGULARITYENV_* included)
// reaches the container. Only `env` entries survive -- Nextflow emits them into
// nxf_container_env(), which is eval'd inside. FimTyper's perl/BLAST tools warn
// when TERM is unset. (No JAVA_TOOL_OPTIONS here: this stage runs no JVM tool --
// see the note in the all_tools configs.)
env {
  TERM = 'dumb'
}

singularity {
  enabled = !fimtyperNative
  autoMounts = true
  cacheDir = singCache
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}
