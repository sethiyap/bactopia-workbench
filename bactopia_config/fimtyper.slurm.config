process {
  executor = 'slurm'
  if (System.getenv('SLURM_PARTITION')) {
    queue = System.getenv('SLURM_PARTITION')
  }
  cpus = 1
  memory = 4.GB
  time = 4.h
  maxForks = 8

  // A transient Singularity failure -- most commonly
  //   "failed to find loop device ... resource temporarily unavailable"
  // when several containers mount on the same node at once -- should not kill the
  // whole stage. Nextflow reports a container creation failure as exit 255. Retry
  // those a few times (with the pbspro/slurm executors each retry is a fresh
  // scheduler job, so there is natural delay before the next attempt) and leave
  // every other failure to Nextflow's default terminate behaviour.
  errorStrategy = { (task.exitStatus in [125, 126, 255] && task.attempt <= 3) ? 'retry' : 'terminate' }
  maxRetries = 3
  if (System.getenv('SLURM_ACCOUNT') || System.getenv('SLURM_CLUSTER_OPTIONS')) {
    clusterOptions = {
      [
        System.getenv('SLURM_ACCOUNT') ? "--account ${System.getenv('SLURM_ACCOUNT')}" : '',
        System.getenv('SLURM_CLUSTER_OPTIONS') ?: ''
      ].findAll { it }.join(' ')
    }
  }

  beforeScript = '''
export TERM="${TERM:-dumb}"
export SINGULARITYENV_TERM=dumb
'''

  withName: 'FIMTYPER' {
    // Auto-pulled from GHCR (published image) so no external install is needed.
    // Override with a local .sif via FIMTYPER_CONTAINER for offline hosts.
    container = System.getenv('FIMTYPER_CONTAINER') ?: 'docker://ghcr.io/sethiyap/agar-bactopia-fimtyper:1.2'
  }
}

executor {
  queueSize = 8
}

singularity {
  enabled = true
  autoMounts = true
  cacheDir = System.getenv('SING_CACHE') ?: '/tmp'
  pullTimeout = '2h'
}

params {
  max_memory = 4.GB
  max_cpus = 1
  max_time = 4.h
}
